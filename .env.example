# MongoDB Connection String
# Get your free MongoDB Atlas cluster at: https://www.mongodb.com/atlas
# Replace <username>, <password>, and <cluster> with your actual values
# Example: mongodb+srv://myuser:mypassword@cluster0.abc123.mongodb.net/mutual_transfer?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mutual_transfer

# Server Port (optional, defaults to 3000)
PORT=3000
